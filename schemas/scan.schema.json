{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScanManifest",
  "type": "object",
  "properties": {
    "base": {
      "$ref": "#/$defs/Design"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScanCase"
      }
    },
    "format": {
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ScanPlan"
    },
    "software_version": {
      "type": "string"
    }
  },
  "required": [
    "format",
    "software_version",
    "base",
    "plan",
    "cases"
  ],
  "$defs": {
    "Aperture": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "radius_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius_mm"
          ]
        },
        {
          "type": "object",
          "properties": {
            "half_height_mm": {
              "type": "number",
              "format": "double"
            },
            "half_width_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "rectangle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "half_width_mm",
            "half_height_mm"
          ]
        }
      ]
    },
    "Coating": {
      "type": "object",
      "properties": {
        "back": {
          "description": "Incidence from the plus side; omission uses the front model on both sides.",
          "anyOf": [
            {
              "$ref": "#/$defs/CoatingModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "front": {
          "description": "Incidence from the minus side of the surface normal.",
          "$ref": "#/$defs/CoatingModel"
        },
        "name": {
          "type": "string"
        },
        "zemax_definition": {
          "description": "Original named coating block, including S/P and phase data for lossless exchange.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "front"
      ]
    },
    "CoatingModel": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reflectance": {
              "type": "number",
              "format": "double"
            },
            "tir_reflectance": {
              "type": "number",
              "format": "double",
              "default": 1.0
            },
            "transmittance": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "ideal"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reflectance",
            "transmittance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "angles_deg": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "coefficients": {
              "description": "Angle-major, then wavelength; each element is [R, T] in power units.",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "low_index_angle": {
              "description": "Zemax TABLE angles refer to the lower-index medium on either traversal.",
              "type": "boolean",
              "default": false
            },
            "tir_reflectance": {
              "type": "number",
              "format": "double",
              "default": 1.0
            },
            "type": {
              "type": "string",
              "const": "table"
            },
            "wavelengths_um": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "wavelengths_um",
            "angles_deg",
            "coefficients"
          ]
        }
      ]
    },
    "Conditions": {
      "description": "Calculation conditions that change how imported definitions are traced.",
      "type": "object",
      "properties": {
        "allow_uncoated": {
          "description": "Trace coated surfaces as uncoated Fresnel interfaces (changes the physics).",
          "type": "boolean",
          "default": false
        },
        "monochromatic_override_um": {
          "description": "Replace every source spectrum with one wavelength in micrometres.",
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "Design": {
      "description": "The design document. Compile it with [`Design::compile`] or [`Design::trace_scene`].",
      "type": "object",
      "properties": {
        "conditions": {
          "$ref": "#/$defs/Conditions",
          "default": {
            "allow_uncoated": false,
            "monochromatic_override_um": null
          }
        },
        "format": {
          "description": "Always `raytrace-design-v1`.",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "name": {
          "description": "Name, reference plane, tracing mode and limits of a composed design. A single\nsystem part placed without transform (see [`Design::lone_system`]) is traced\nas it is and uses its own scene header instead.",
          "type": "string"
        },
        "next_id": {
          "description": "Next number for new ids; numbers are never reused.",
          "type": "integer",
          "format": "uint64",
          "default": 1,
          "minimum": 0
        },
        "occurrences": {
          "description": "Root-level placements in order; names of composed surfaces use their position.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Occurrence"
          }
        },
        "parts": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Part"
          }
        },
        "reference_plane": {
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        }
      },
      "additionalProperties": false,
      "required": [
        "format",
        "name",
        "reference_plane",
        "settings",
        "mode"
      ]
    },
    "DetectorMetrics": {
      "type": "object",
      "properties": {
        "fwhm_mm": {
          "type": "array",
          "items": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "name": {
          "type": "string"
        },
        "received_percent": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "name",
        "received_percent",
        "fwhm_mm"
      ]
    },
    "Diode": {
      "type": "object",
      "properties": {
        "angular_supergaussian": {
          "type": "array",
          "default": [
            1.0,
            1.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "array": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "astigmatism_mm": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "divergence_deg": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "gaussian_width_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "half_width_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "rotation_deg": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "spacing_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "spatial_supergaussian": {
          "type": "array",
          "default": [
            1.0,
            1.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "rotation_deg",
        "divergence_deg",
        "array",
        "spacing_mm",
        "half_width_mm",
        "gaussian_width_mm"
      ]
    },
    "Interaction": {
      "oneOf": [
        {
          "description": "The minus/plus medium is on the -/+ side of the local sag normal.",
          "type": "object",
          "properties": {
            "minus_medium": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "plus_medium": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "reflectance": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "dielectric"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "minus_medium",
            "plus_medium"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reflectance": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "mirror"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reflectance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "absorb"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pixels": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2
            },
            "type": {
              "type": "string",
              "const": "detector"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "pixels"
          ]
        }
      ]
    },
    "Issue": {
      "description": "A condition found while importing or editing a definition.",
      "type": "object",
      "properties": {
        "blocking": {
          "description": "An unsupported physical definition prevents tracing.",
          "type": "boolean"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "blocking"
      ]
    },
    "Material": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "coefficients": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "formula": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "catalog"
            },
            "valid_range_um": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "formula",
            "coefficients",
            "valid_range_um"
          ]
        },
        {
          "type": "object",
          "properties": {
            "dispersion": {
              "$ref": "#/$defs/Material"
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "type": {
              "type": "string",
              "const": "with_absorption"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "dispersion",
            "samples"
          ]
        },
        {
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "n": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "constant"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "n"
          ]
        },
        {
          "description": "n² = 1 + sum(B_i * lambda² / (lambda² - C_i)). C_i has units um².",
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "b": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "c_um2": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "type": {
              "type": "string",
              "const": "sellmeier"
            },
            "valid_range_um": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "b",
            "c_um2",
            "valid_range_um"
          ]
        },
        {
          "description": "n² = A0 + A1*l² + A2/l² + A3/l⁴ + A4/l⁶ + A5/l⁸ (AGF formula 1).",
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "coefficients": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 6,
              "minItems": 6
            },
            "type": {
              "type": "string",
              "const": "schott"
            },
            "valid_range_um": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "coefficients",
            "valid_range_um"
          ]
        },
        {
          "description": "Sorted [wavelength_um, n] pairs. Linear interpolation, no extrapolation.",
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "type": {
              "type": "string",
              "const": "tabulated"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "samples"
          ]
        }
      ]
    },
    "Mode": {
      "description": "`sequential` follows the surface order and terminates at TIR;\n`non_sequential` follows the nearest hit and splits reflection and transmission.",
      "type": "string",
      "enum": [
        "sequential",
        "non_sequential"
      ]
    },
    "Occurrence": {
      "description": "A placed instance of a part: a rigid transform plus an enabled switch.",
      "type": "object",
      "properties": {
        "anchor_mm": {
          "description": "Local point placed at `pose.translation_mm`: lens first vertex or source-array centre.",
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "id": {
          "$ref": "#/$defs/OccurrenceId"
        },
        "name": {
          "type": "string"
        },
        "part": {
          "$ref": "#/$defs/PartId"
        },
        "pose": {
          "$ref": "#/$defs/Pose",
          "default": {
            "rotation_deg": [
              0.0,
              0.0,
              0.0
            ],
            "translation_mm": [
              0.0,
              0.0,
              0.0
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "part",
        "name"
      ]
    },
    "OccurrenceId": {
      "description": "Identifier of a occurrence, unique within the design document.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "OpticalPupil": {
      "type": "object",
      "properties": {
        "aiming": {
          "$ref": "#/$defs/RayAiming"
        },
        "finite_field_angle_deg": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "first_surface": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "primary_wavelength_um": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "first_surface",
        "primary_wavelength_um",
        "aiming"
      ]
    },
    "Parameter": {
      "description": "Scanned value. Components are addressed by occurrence id and surfaces by name; axis\n0/1/2 is X/Y/Z.",
      "oneOf": [
        {
          "description": "Occurrence position in mm.",
          "type": "object",
          "properties": {
            "axis": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "occurrence": {
              "$ref": "#/$defs/OccurrenceId"
            },
            "type": {
              "type": "string",
              "const": "component_position"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "occurrence",
            "axis"
          ]
        },
        {
          "description": "Occurrence rotation in degrees.",
          "type": "object",
          "properties": {
            "axis": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "occurrence": {
              "$ref": "#/$defs/OccurrenceId"
            },
            "type": {
              "type": "string",
              "const": "component_rotation"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "occurrence",
            "axis"
          ]
        },
        {
          "description": "Rod width X / width Y / length (axis 0/1/2) in mm, of the occurrence's rod part.",
          "type": "object",
          "properties": {
            "axis": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "occurrence": {
              "$ref": "#/$defs/OccurrenceId"
            },
            "type": {
              "type": "string",
              "const": "rod_size"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "occurrence",
            "axis"
          ]
        },
        {
          "description": "Surface position in mm, in the coordinates of its part. Without `occurrence` the\ndesign must be a single unplaced system.",
          "type": "object",
          "properties": {
            "axis": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "occurrence": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OccurrenceId"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "surface": {
              "description": "Surface name in the part.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "surface_position"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "surface",
            "axis"
          ]
        },
        {
          "description": "Surface rotation in degrees, in the coordinates of its part.",
          "type": "object",
          "properties": {
            "axis": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "occurrence": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OccurrenceId"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "surface": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "surface_rotation"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "surface",
            "axis"
          ]
        },
        {
          "description": "Wavelength of every source in micrometres.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "wavelength"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "ParameterLink": {
      "description": "target = source * scale + offset; scale is dimensionless, offset uses target units.",
      "type": "object",
      "properties": {
        "offset": {
          "type": "number",
          "format": "double"
        },
        "scale": {
          "type": "number",
          "format": "double"
        },
        "source": {
          "$ref": "#/$defs/Parameter"
        },
        "target": {
          "$ref": "#/$defs/Parameter"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "scale",
        "offset"
      ]
    },
    "Part": {
      "description": "A part definition in its own local coordinates.",
      "type": "object",
      "properties": {
        "cad_deflection_mm": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions",
          "default": {
            "allow_uncoated": false,
            "monochromatic_override_um": null
          }
        },
        "id": {
          "$ref": "#/$defs/PartId"
        },
        "issues": {
          "description": "Import findings that may block tracing.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Issue"
          }
        },
        "kind": {
          "$ref": "#/$defs/PartKind"
        },
        "material_names": {
          "description": "One display name per entry of `scene.materials`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "rod": {
          "anyOf": [
            {
              "$ref": "#/$defs/RodSize"
            },
            {
              "type": "null"
            }
          ]
        },
        "scene": {
          "description": "Local optical definition: materials, surfaces, sources, and (for a `system`\npart) the name, reference plane, tracing mode and limits of the whole system.\nA `rod` part keeps its material in slot 1; its six faces are generated from `rod`.",
          "$ref": "#/$defs/Scene"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "scene",
        "material_names"
      ]
    },
    "PartId": {
      "description": "Identifier of a part, unique within the design document.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "PartKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "source",
            "optic",
            "rod",
            "detector"
          ]
        },
        {
          "description": "A complete optical system: surfaces, sources and tracing mode.",
          "type": "string",
          "const": "system"
        }
      ]
    },
    "Pose": {
      "type": "object",
      "properties": {
        "rotation_deg": {
          "description": "Active rotations: Rx, then Ry, then Rz, in the world frame.",
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "translation_mm": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false
    },
    "Provenance": {
      "description": "Where a part was imported from. The document keeps it as an opaque JSON value;\nonly the input/output layer interprets it (for example to export ZMX again).",
      "type": "object",
      "properties": {
        "document": true,
        "format": {
          "description": "Name of the source format, for example `zmx`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "format",
        "document"
      ]
    },
    "PupilIllumination": {
      "description": "Uniform area samples on a pupil. Finite objects emit from a point; infinite\nobjects launch a parallel bundle whose intersections fill the pupil.",
      "type": "object",
      "properties": {
        "aperture": {
          "$ref": "#/$defs/Aperture"
        },
        "finite_object": {
          "type": "boolean"
        },
        "optical": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpticalPupil"
            },
            {
              "type": "null"
            }
          ]
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "surface": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "vignetting": {
          "$ref": "#/$defs/Vignetting"
        }
      },
      "additionalProperties": false,
      "required": [
        "pose",
        "aperture",
        "finite_object"
      ]
    },
    "RayAiming": {
      "type": "string",
      "enum": [
        "off",
        "paraxial",
        "real"
      ]
    },
    "RodSize": {
      "type": "object",
      "properties": {
        "coatings": {
          "description": "Optional power coatings on entrance, exit, or sides.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Coating"
          }
        },
        "height_mm": {
          "type": "number",
          "format": "double"
        },
        "length_mm": {
          "type": "number",
          "format": "double"
        },
        "width_mm": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "width_mm",
        "height_mm",
        "length_mm"
      ]
    },
    "Sampling": {
      "type": "string",
      "enum": [
        "sobol",
        "pseudorandom"
      ]
    },
    "ScanAxis": {
      "type": "object",
      "properties": {
        "parameter": {
          "$ref": "#/$defs/Parameter"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "parameter",
        "values"
      ]
    },
    "ScanCase": {
      "type": "object",
      "properties": {
        "detected_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "detectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DetectorMetrics"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "secondary_value": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "state": {
          "type": "string"
        },
        "trace_seconds": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "value": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "value",
        "state",
        "detectors"
      ]
    },
    "ScanPlan": {
      "description": "`plan` of the `scan` command. At most 256 cases.",
      "type": "object",
      "properties": {
        "links": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/ParameterLink"
          }
        },
        "parameter": {
          "$ref": "#/$defs/Parameter",
          "default": {
            "type": "wavelength"
          }
        },
        "rays_per_source": {
          "description": "Rays per source for every case; null keeps the model setting.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "secondary": {
          "description": "Optional second axis; every combination with `values` is traced.",
          "anyOf": [
            {
              "$ref": "#/$defs/ScanAxis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "threads": {
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        },
        "values": {
          "description": "Values of `parameter` in its unit (mm, deg or um).",
          "type": "array",
          "default": [
            0.45,
            0.55,
            0.635
          ],
          "items": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "additionalProperties": false
    },
    "Scene": {
      "description": "Optical model: materials, surfaces, sources and trace limits.\nLengths are mm and wavelengths are micrometres. `examples/*.json` use this format.",
      "type": "object",
      "properties": {
        "materials": {
          "description": "Material table; surfaces and rays refer to materials by index. Index 0 is usually air.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Material"
          }
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "name": {
          "type": "string"
        },
        "reference_plane": {
          "description": "Describes where the launched weight is counted as 100 %.",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/Settings",
          "default": {
            "max_depth": 64,
            "max_events_per_launch": 4096,
            "min_relative_branch_weight": 1e-7
          }
        },
        "sources": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "surfaces": {
          "description": "Surfaces in sequential order (non-sequential tracing uses the nearest hit).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Surface"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "reference_plane",
        "mode",
        "materials",
        "surfaces"
      ]
    },
    "Settings": {
      "type": "object",
      "properties": {
        "max_depth": {
          "type": "integer",
          "format": "uint",
          "default": 64,
          "minimum": 0
        },
        "max_events_per_launch": {
          "type": "integer",
          "format": "uint",
          "default": 4096,
          "minimum": 0
        },
        "min_relative_branch_weight": {
          "type": "number",
          "format": "double",
          "default": 1e-7
        }
      },
      "additionalProperties": false
    },
    "Shape": {
      "oneOf": [
        {
          "description": "Side of a closed lens barrel: z in [0,length], outward-pointing normal.",
          "type": "object",
          "properties": {
            "length_mm": {
              "type": "number",
              "format": "double"
            },
            "radius_end_mm": {
              "type": "number",
              "format": "double"
            },
