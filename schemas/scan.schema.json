          "additionalProperties": false,
          "required": [
            "type",
            "radius_start_mm",
            "radius_end_mm",
            "length_mm"
          ]
        },
        {
          "type": "object",
          "properties": {
            "normals": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 3,
                "minItems": 3
              }
            },
            "triangles": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "maxItems": 3,
                "minItems": 3
              }
            },
            "type": {
              "type": "string",
              "const": "triangle_mesh"
            },
            "vertices": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 3,
                "minItems": 3
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "vertices",
            "triangles",
            "normals"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plane"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Coefficients are A4, A6, A8, ... in increasing order.",
          "type": "object",
          "properties": {
            "coefficients": {
              "type": "array",
              "default": [],
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "type": {
              "type": "string",
              "const": "flat_even_asphere"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "The vertex-centred sag cap; radius is signed. This is not a full sphere.",
          "type": "object",
          "properties": {
            "radius_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "sphere"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius_mm"
          ]
        },
        {
          "description": "Coefficients are A4, A6, A8, ... in increasing order.",
          "type": "object",
          "properties": {
            "coefficients": {
              "type": "array",
              "default": [],
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "conic": {
              "type": "number",
              "format": "double"
            },
            "radius_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "even_asphere"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius_mm",
            "conic"
          ]
        }
      ]
