{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scene",
  "description": "Optical model: materials, surfaces, sources and trace limits.\nLengths are mm and wavelengths are micrometres. `examples/*.json` use this format.",
  "type": "object",
  "properties": {
    "materials": {
      "description": "Material table; surfaces and rays refer to materials by index. Index 0 is usually air.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Material"
      }
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "name": {
      "type": "string"
    },
    "reference_plane": {
      "description": "Describes where the launched weight is counted as 100 %.",
      "type": "string"
    },
    "settings": {
      "$ref": "#/$defs/Settings",
      "default": {
        "max_depth": 64,
        "max_events_per_launch": 4096,
        "min_relative_branch_weight": 1e-7
      }
    },
    "sources": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Source"
      }
    },
    "surfaces": {
      "description": "Surfaces in sequential order (non-sequential tracing uses the nearest hit).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Surface"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "reference_plane",
    "mode",
    "materials",
    "surfaces"
  ],
  "$defs": {
    "Aperture": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "radius_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "circle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius_mm"
          ]
        },
        {
          "type": "object",
          "properties": {
            "half_height_mm": {
              "type": "number",
              "format": "double"
            },
            "half_width_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "rectangle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "half_width_mm",
            "half_height_mm"
          ]
        }
      ]
    },
    "Coating": {
      "type": "object",
      "properties": {
        "back": {
          "description": "Incidence from the plus side; omission uses the front model on both sides.",
          "anyOf": [
            {
              "$ref": "#/$defs/CoatingModel"
            },
            {
              "type": "null"
            }
          ]
        },
        "front": {
          "description": "Incidence from the minus side of the surface normal.",
          "$ref": "#/$defs/CoatingModel"
        },
        "name": {
          "type": "string"
        },
        "zemax_definition": {
          "description": "Original named coating block, including S/P and phase data for lossless exchange.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "front"
      ]
    },
    "CoatingModel": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "reflectance": {
              "type": "number",
              "format": "double"
            },
            "tir_reflectance": {
              "type": "number",
              "format": "double",
              "default": 1.0
            },
            "transmittance": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "ideal"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reflectance",
            "transmittance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "angles_deg": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "coefficients": {
              "description": "Angle-major, then wavelength; each element is [R, T] in power units.",
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "low_index_angle": {
              "description": "Zemax TABLE angles refer to the lower-index medium on either traversal.",
              "type": "boolean",
              "default": false
            },
            "tir_reflectance": {
              "type": "number",
              "format": "double",
              "default": 1.0
            },
            "type": {
              "type": "string",
              "const": "table"
            },
            "wavelengths_um": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "wavelengths_um",
            "angles_deg",
            "coefficients"
          ]
        }
      ]
    },
    "Diode": {
      "type": "object",
      "properties": {
        "angular_supergaussian": {
          "type": "array",
          "default": [
            1.0,
            1.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "array": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "maxItems": 2,
          "minItems": 2
        },
        "astigmatism_mm": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "divergence_deg": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "gaussian_width_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "half_width_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "rotation_deg": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "spacing_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "spatial_supergaussian": {
          "type": "array",
          "default": [
            1.0,
            1.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "required": [
        "rotation_deg",
        "divergence_deg",
        "array",
        "spacing_mm",
        "half_width_mm",
        "gaussian_width_mm"
      ]
    },
    "Interaction": {
      "oneOf": [
        {
          "description": "The minus/plus medium is on the -/+ side of the local sag normal.",
          "type": "object",
          "properties": {
            "minus_medium": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "plus_medium": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "reflectance": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "dielectric"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "minus_medium",
            "plus_medium"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reflectance": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "mirror"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reflectance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "absorb"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "pixels": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "uint",
                "minimum": 0
              },
              "maxItems": 2,
              "minItems": 2
            },
            "type": {
              "type": "string",
              "const": "detector"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "pixels"
          ]
        }
      ]
    },
    "Material": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "coefficients": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "formula": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "catalog"
            },
            "valid_range_um": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "formula",
            "coefficients",
            "valid_range_um"
          ]
        },
        {
          "type": "object",
          "properties": {
            "dispersion": {
              "$ref": "#/$defs/Material"
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "type": {
              "type": "string",
              "const": "with_absorption"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "dispersion",
            "samples"
          ]
        },
        {
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "n": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "constant"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "n"
          ]
        },
        {
          "description": "n² = 1 + sum(B_i * lambda² / (lambda² - C_i)). C_i has units um².",
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "b": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "c_um2": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 3,
              "minItems": 3
            },
            "type": {
              "type": "string",
              "const": "sellmeier"
            },
            "valid_range_um": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "b",
            "c_um2",
            "valid_range_um"
          ]
        },
        {
          "description": "n² = A0 + A1*l² + A2/l² + A3/l⁴ + A4/l⁶ + A5/l⁸ (AGF formula 1).",
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "coefficients": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 6,
              "minItems": 6
            },
            "type": {
              "type": "string",
              "const": "schott"
            },
            "valid_range_um": {
              "type": "array",
              "items": {
                "type": "number",
                "format": "double"
              },
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "coefficients",
            "valid_range_um"
          ]
        },
        {
          "description": "Sorted [wavelength_um, n] pairs. Linear interpolation, no extrapolation.",
          "type": "object",
          "properties": {
            "absorption_per_mm": {
              "type": "number",
              "format": "double",
              "default": 0.0
            },
            "samples": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 2,
                "minItems": 2
              }
            },
            "type": {
              "type": "string",
              "const": "tabulated"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "samples"
          ]
        }
      ]
    },
    "Mode": {
      "description": "`sequential` follows the surface order and terminates at TIR;\n`non_sequential` follows the nearest hit and splits reflection and transmission.",
      "type": "string",
      "enum": [
        "sequential",
        "non_sequential"
      ]
    },
    "OpticalPupil": {
      "type": "object",
      "properties": {
        "aiming": {
          "$ref": "#/$defs/RayAiming"
        },
        "finite_field_angle_deg": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "first_surface": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "primary_wavelength_um": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "first_surface",
        "primary_wavelength_um",
        "aiming"
      ]
    },
    "Pose": {
      "type": "object",
      "properties": {
        "rotation_deg": {
          "description": "Active rotations: Rx, then Ry, then Rz, in the world frame.",
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "translation_mm": {
          "type": "array",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false
    },
    "PupilIllumination": {
      "description": "Uniform area samples on a pupil. Finite objects emit from a point; infinite\nobjects launch a parallel bundle whose intersections fill the pupil.",
      "type": "object",
      "properties": {
        "aperture": {
          "$ref": "#/$defs/Aperture"
        },
        "finite_object": {
          "type": "boolean"
        },
        "optical": {
          "anyOf": [
            {
              "$ref": "#/$defs/OpticalPupil"
            },
            {
              "type": "null"
            }
          ]
        },
        "pose": {
          "$ref": "#/$defs/Pose"
        },
        "surface": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "vignetting": {
          "$ref": "#/$defs/Vignetting"
        }
      },
      "additionalProperties": false,
      "required": [
        "pose",
        "aperture",
        "finite_object"
      ]
    },
    "RayAiming": {
      "type": "string",
      "enum": [
        "off",
        "paraxial",
        "real"
      ]
    },
    "Sampling": {
      "type": "string",
      "enum": [
        "sobol",
        "pseudorandom"
      ]
    },
    "Settings": {
      "type": "object",
      "properties": {
        "max_depth": {
          "type": "integer",
          "format": "uint",
          "default": 64,
          "minimum": 0
        },
        "max_events_per_launch": {
          "type": "integer",
          "format": "uint",
          "default": 4096,
          "minimum": 0
        },
        "min_relative_branch_weight": {
          "type": "number",
          "format": "double",
          "default": 1e-7
        }
      },
      "additionalProperties": false
    },
    "Shape": {
      "oneOf": [
        {
          "description": "Side of a closed lens barrel: z in [0,length], outward-pointing normal.",
          "type": "object",
          "properties": {
            "length_mm": {
              "type": "number",
              "format": "double"
            },
            "radius_end_mm": {
              "type": "number",
              "format": "double"
            },
            "radius_start_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "conical_side"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius_start_mm",
            "radius_end_mm",
            "length_mm"
          ]
        },
        {
          "type": "object",
          "properties": {
            "normals": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 3,
                "minItems": 3
              }
            },
            "triangles": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "maxItems": 3,
                "minItems": 3
              }
            },
            "type": {
              "type": "string",
              "const": "triangle_mesh"
            },
            "vertices": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number",
                  "format": "double"
                },
                "maxItems": 3,
                "minItems": 3
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "vertices",
            "triangles",
            "normals"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plane"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Coefficients are A4, A6, A8, ... in increasing order.",
          "type": "object",
          "properties": {
            "coefficients": {
              "type": "array",
              "default": [],
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "type": {
              "type": "string",
              "const": "flat_even_asphere"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "The vertex-centred sag cap; radius is signed. This is not a full sphere.",
          "type": "object",
          "properties": {
            "radius_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "sphere"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius_mm"
          ]
        },
        {
          "description": "Coefficients are A4, A6, A8, ... in increasing order.",
          "type": "object",
          "properties": {
            "coefficients": {
              "type": "array",
              "default": [],
              "items": {
                "type": "number",
                "format": "double"
              }
            },
            "conic": {
              "type": "number",
              "format": "double"
            },
            "radius_mm": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "even_asphere"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "radius_mm",
            "conic"
          ]
        }
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "cone_half_angle_deg": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "diode": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diode"
            },
            {
              "type": "null"
            }
          ]
        },
        "direction": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "disk_radius_mm": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "medium": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "origin_mm": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "pupil": {
          "anyOf": [
            {
              "$ref": "#/$defs/PupilIllumination"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampling": {
          "$ref": "#/$defs/Sampling",
          "default": "sobol"
        },
        "seed": {
          "type": "integer",
          "format": "uint64",
          "default": 0,
          "minimum": 0
        },
        "spectrum": {
          "anyOf": [
            {
              "$ref": "#/$defs/Spectrum"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_weight": {
          "description": "Arbitrary power units; the sum at launch defines the reference plane.",
          "type": "number",
          "format": "double"
        },
        "wavelength_um": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "count",
        "origin_mm",
        "direction",
        "wavelength_um",
        "medium",
        "total_weight"
      ]
    },
    "Spectrum": {
      "type": "object",
      "properties": {
        "samples": {
          "description": "Ascending [wavelength_um, relative_power] pairs, sampled without interpolation.",
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
